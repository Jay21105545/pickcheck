{
  "name": "pickcheck",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "check": "biome check .",
    "self-audit": "pnpm --filter @pickcheck/cli run build && node packages/cli/dist/index.js audit --min 90"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
