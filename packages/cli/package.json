{
  "name": "pickcheck",
  "version": "0.0.1",
  "private": true,
  "description": "Lighthouse for AI-built apps — a zero-config CLI that audits security, docs, discipline, UI/UX, and AI-context-token hygiene, and hands back ready-to-paste fix prompts. No LLM calls, no network, no config required.",
  "keywords": [
    "cli",
    "audit",
    "code-quality",
    "linter",
    "static-analysis",
    "ai",
    "code-review",
    "security",
    "accessibility",
    "developer-tools"
  ],
  "homepage": "https://github.com/Jay21105545/pickcheck#readme",
  "bugs": "https://github.com/Jay21105545/pickcheck/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jay21105545/pickcheck.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Jay21105545",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pickcheck": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@clack/prompts": "^1.7.0",
    "@pickcheck/report": "workspace:^",
    "@pickcheck/rules": "workspace:^",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "gpt-tokenizer": "^4.0.0",
    "ignore": "^7.0.8",
    "micromatch": "^4.0.8",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.4.1"
  }
}
